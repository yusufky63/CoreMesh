{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vinext build",
    "start": "node .output/server/index.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "vitest run --config vitest.config.ts",
    "worker:build": "esbuild scripts/coremesh-worker.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/worker/coremesh-worker.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "worker": "npm run worker:build && node dist/worker/coremesh-worker.mjs",
    "mcp:build": "esbuild scripts/coremesh-mcp.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/worker/coremesh-mcp.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "mcp": "npm run mcp:build && node dist/worker/coremesh-mcp.mjs",
    "check": "npm run lint && tsc --noEmit && npm test && npm run build && npm run worker:build && npm run mcp:build"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@shadcn/react": "0.3.0",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cytoscape": "^3.34.2",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "hash-wasm": "^4.12.0",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "nitro": "^3.0.260903-beta",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.7",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "sharp": "0.35.4",
    "undici": "7.29.0",
    "ws": "8.21.0"
  },
  "type": "module"
}
